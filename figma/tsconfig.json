{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": [
      "@figma/code-connect/figma-types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "*.figma.ts",
    "mental-health/*.figma.ts",
    "h5/*.figma.ts"
  ]
}
